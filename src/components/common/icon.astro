---
import { Icon } from "astro-icon/components";
import collections from "@/assets/icons/runtime-icons.json";

export interface Props {
    icon: string;
    class?: string;
    style?: string;
    size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl";
    color?: string;
    fallback?: string;
    loading?: "lazy" | "eager";
}

const { icon, class: className = "", style = "", size = "md", color, fallback = "●" } = Astro.props;
const sizes = { xs: "text-xs", sm: "text-sm", md: "text-base", lg: "text-lg", xl: "text-xl", "2xl": "text-2xl" };
const [prefix, name] = icon.split(":");
const available = collections.some(set => set.prefix === prefix && Object.hasOwn(set.icons, name));
---
<span class={`inline-flex items-center justify-center ${sizes[size]} ${className}`}
    style={`${color ? `color: ${color};` : ""}${style}`} data-local-icon={icon}>
    {available ? <Icon name={icon} size="1em" is:inline /> : <span>{fallback}</span>}
</span>
