---
import { Image } from "astro:assets";
import path from "node:path";
import { url } from "@utils/url";
import type { ImageMetadata } from "astro";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	style?: string;
	loading?: "lazy" | "eager";
	decoding?: "async" | "auto" | "sync";
	fallbackSrc?: string;
	debugLabel?: string;
}

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	style,
	loading = "lazy",
	decoding = "async",
	fallbackSrc,
	debugLabel,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,gif,avif,svg}",
		{
		import: "default",
		},
	);
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
const resolvedFallbackSrc = fallbackSrc
	? fallbackSrc.startsWith("/")
		? url(fallbackSrc)
		: fallbackSrc
	: undefined;
const resolvedSrc = isPublic ? url(src) : src;
const enableImageDebug = Boolean(debugLabel);
---

<div id={id} class:list={[className, 'overflow-hidden relative']} style={style}>
    <div class="transition absolute inset-0 bg-black/3 dark:bg-black/9 pointer-events-none"></div>
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} decoding={decoding}/>}
	{!isLocal && enableImageDebug && (
		<script is:inline define:vars={{ debugLabel, resolvedSrc, resolvedFallbackSrc }}>
			console.info("[DailyWall] image render", {
				label: debugLabel,
				src: resolvedSrc,
				fallbackSrc: resolvedFallbackSrc,
				page: window.location.href,
			});
		</script>
	)}
	{!isLocal && <img src={resolvedSrc} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} decoding={decoding} data-fallback-src={resolvedFallbackSrc} data-debug-label={debugLabel} data-original-src={resolvedSrc} onload="if (this.dataset.debugLabel) { console.info('[DailyWall] image loaded', { label: this.dataset.debugLabel, currentSrc: this.currentSrc || this.src, originalSrc: this.dataset.originalSrc, isFallback: this.dataset.fallbackApplied === 'true', naturalWidth: this.naturalWidth, naturalHeight: this.naturalHeight }); }" onerror="if (this.dataset.debugLabel) { console.error('[DailyWall] image error', { label: this.dataset.debugLabel, currentSrc: this.currentSrc || this.src, originalSrc: this.dataset.originalSrc, fallbackSrc: this.dataset.fallbackSrc, fallbackApplied: this.dataset.fallbackApplied === 'true' }); } if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc && this.dataset.fallbackApplied !== 'true') { if (this.dataset.debugLabel) { console.warn('[DailyWall] switching to fallback', { label: this.dataset.debugLabel, from: this.src, to: this.dataset.fallbackSrc }); } this.dataset.fallbackApplied = 'true'; this.src = this.dataset.fallbackSrc; }"/>}
</div>