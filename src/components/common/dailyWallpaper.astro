---
interface Props {
    id?: string;
    position?: string;
    blur?: number;
    label?: string;
}
const { id, position = 'center', blur = 0, label = 'daily-wall' } = Astro.props;
---
<div id={id} class="relative h-full w-full overflow-hidden">
    <div class="transition absolute inset-0 bg-black/3 dark:bg-black/9 pointer-events-none"></div>
    <picture>
        <source media="(orientation: landscape)" srcset="https://api.bingpics.ybjun.com/image/latest" />
        <img
            src="https://api.bingpics.ybjun.com/image/latest/v"
            alt="Bing 每日壁纸"
            class="h-full w-full object-cover"
            style={`object-position: ${position};${blur > 0 ? `filter: blur(${blur}px);` : ''}`}
            loading="eager"
            decoding="async"
            data-daily-wall={label}
            onerror="if (!this.dataset.fallbackApplied) { this.dataset.fallbackApplied = 'true'; this.closest('picture').querySelector('source').removeAttribute('srcset'); this.src = matchMedia('(orientation: landscape)').matches ? '/assets/images/wallpaper_fallback/desktopWallpaper_fallback.webp' : '/assets/images/wallpaper_fallback/mobileWallpaper_fallback.webp'; }"
        />
    </picture>
</div>
