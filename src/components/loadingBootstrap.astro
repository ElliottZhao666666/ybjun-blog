<!-- Keep this classic inline script before stylesheets and module scripts. -->
<script is:inline data-swup-ignore-script>
(() => {
    if (window.__blogLoadingInitialized) return;
    window.__blogLoadingInitialized = true;
    const root = document.documentElement;
    let finished = false;
    let earlyHelp;
    const alternateHost = location.hostname === 'www.ybjun.com' ? 'ybjun.com' : 'www.ybjun.com';
    const alternateURL = `https://${alternateHost}${location.pathname}${location.search}${location.hash}`;
    const updateLink = () => {
        const link = document.getElementById('loading-alternate-domain');
        if (link && link.href !== alternateURL) {
            link.href = alternateURL;
            link.textContent = `换用 ${alternateHost} 访问`;
        }
        // The HTML stream may stop inside the large head, before the real
        // overlay/body exists. Keep this escape route until body markup arrives.
        if (earlyHelp && document.getElementById('loading-overlay')) {
            earlyHelp.remove();
            earlyHelp = undefined;
            if (finished) observer.disconnect();
        }
    };
    const showEarlyHelp = () => {
        if (document.getElementById('loading-overlay')) return;
        earlyHelp = document.createElement('div');
        earlyHelp.id = 'loading-early-help';
        earlyHelp.setAttribute('role', 'status');
        for (const text of ['加载时间较长，可能是网络环境导致。', '您可以刷新页面，或换一个域名继续访问。']) {
            const line = document.createElement('p');
            line.textContent = text;
            earlyHelp.append(line);
        }
        const actions = document.createElement('div');
        const refresh = document.createElement('button');
        refresh.type = 'button';
        refresh.textContent = '刷新页面';
        refresh.onclick = () => location.reload();
        const alternate = document.createElement('a');
        alternate.href = alternateURL;
        alternate.textContent = `换用 ${alternateHost} 访问`;
        actions.append(refresh, alternate);
        earlyHelp.append(actions);
        root.append(earlyHelp);
    };
    const finish = (timedOut = false) => {
        if (finished) return;
        finished = true;
        clearTimeout(warningTimer);
        clearTimeout(deadlineTimer);
        if (!earlyHelp) observer.disconnect();
        root.classList.remove('is-loading', 'loading-slow', 'banner-restoring');
        root.classList.add('show-initial-animation');
        if (timedOut) root.dataset.loadingFallback = 'true';
        const overlay = document.getElementById('loading-overlay');
        overlay?.classList.add('fade-out');
        setTimeout(() => {
            if (overlay) overlay.style.display = 'none';
            document.dispatchEvent(new Event('blog:loading:finished'));
        }, 600);
        setTimeout(() => root.classList.remove('show-initial-animation'), 1200);
    };
    const warningTimer = setTimeout(() => {
        if (!finished) {
            updateLink();
            showEarlyHelp();
            root.classList.add('loading-slow');
        }
    }, 8000);
    const deadlineTimer = setTimeout(() => finish(true), 10000);
    const observer = new MutationObserver(updateLink);
    observer.observe(document, { childList: true, subtree: true });
    // "interactive" precedes deferred/module execution, unlike DOMContentLoaded.
    document.addEventListener('readystatechange', () => {
        if (document.readyState !== 'loading') finish();
    });
    if (document.readyState !== 'loading') finish();
})();
</script>
<style is:inline>
    html:not(.is-loading) #loading-overlay { opacity: 0; pointer-events: none; }
    #loading-slow-help { display: none; }
    html.loading-slow #loading-slow-help { display: block; }
    html.loading-slow #loading-overlay .loading-title { display: none; }
    #loading-early-help {
        position: fixed; inset: 0; z-index: 100; display: flex;
        flex-direction: column; align-items: center; justify-content: center;
        padding: 1.5rem; text-align: center; line-height: 1.8;
        color: var(--primary, oklch(.7 .14 var(--configHue, 145)));
        background: var(--page-bg, #f0f2f5); font-family: var(--global-font-family, system-ui);
    }
    html.dark #loading-early-help { background: var(--page-bg, #12151a); }
    #loading-early-help p { margin: 0; }
    #loading-early-help > div { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 1rem; }
    #loading-early-help :is(button, a) {
        display: inline-flex; align-items: center; justify-content: center;
        padding: .4rem .9rem; border-radius: .75rem; cursor: pointer;
        color: inherit; background: color-mix(in oklch, currentColor 8%, transparent);
        border: 1px solid color-mix(in oklch, currentColor 25%, transparent);
        font: inherit; text-decoration: none;
    }
    #loading-early-help :is(button, a):hover,
    #loading-early-help :is(button, a):focus-visible { background: color-mix(in oklch, currentColor 18%, transparent); }
</style>
<noscript>
    <style>
        html.is-loading { overflow: auto !important; }
        #loading-overlay { display: none !important; }
        html.is-loading:not(.banner-restoring) #banner-wrapper { height: var(--banner-height-home) !important; }
        .banner-title, .banner-subtitle, .onload-animation-up, .onload-animation-down { opacity: 1 !important; }
    </style>
</noscript>
